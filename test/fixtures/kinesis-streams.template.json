{
  "Mappings": {
    "ProxylityConfig": {
      "Fn::Transform": {
        "Name": "AWS::Include",
        "Parameters": {
          "Location": {
            "Fn::Sub": "s3://proxylity-config-${AWS::Region}/${AWS::AccountId}/customer-config.json"
          }
        }
      }
    }
  },
  "Listener": {
    "ServiceToken": {
      "Fn::FindInMap": ["ProxylityConfig", { "Ref": "AWS::Region" }, "ServiceToken"]
    },
    "ApiKey": {
      "Fn::FindInMap": ["ProxylityConfig", "Account", "ApiKey"]
    },
    "Protocols": ["udp"],
    "ClientRestrictions": {
      "Networks": [{ "Ref": "ClientCidrToAllow" }]
    },
    "Destinations": [
      {
        "Description": "Deliver UDP packets to Kinesis Data Streams with dynamic partition key extracted from payload.",
        "Role": {
          "Arn": { "Fn::GetAtt": ["DestinationRole", "Arn"] }
        },
        "Formatter": "base64",
        "Batching": {
          "Count": 100,
          "TimeoutInSeconds": 1
        },
        "MetricsEnabled": true,
        "LogGroupName": { "Ref": "KinesisLogs" },
        "DestinationArn": {
          "Fn::GetAtt": ["KinesisStream", "Arn"]
        },
        "Arguments": {
          "PartitionKeyExpression": "[0:4]",
          "PartitionKeyExpressionFormatter": "hex"
        }
      }
    ]
  }
}
