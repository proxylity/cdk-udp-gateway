{
  "name": "@proxylity/cdk-udp-gateway",
  "version": "0.1.0",
  "description": "L1 (CloudFormation-faithful) AWS CDK construct library for the Proxylity UDP Gateway custom resources.",
  "license": "Apache-2.0",
  "author": {
    "name": "Proxylity",
    "organization": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/proxylity/cdk-udp-gateway.git"
  },
  "homepage": "https://proxylity.com",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "stability": "experimental",
  "keywords": [
    "aws",
    "cdk",
    "aws-cdk",
    "proxylity",
    "udp",
    "udp-gateway"
  ],
  "scripts": {
    "compile": "jsii --silence-warnings=reserved-word",
    "watch": "jsii -w",
    "build": "jsii --silence-warnings=reserved-word && jsii-docgen -o API.md || jsii --silence-warnings=reserved-word",
    "package": "jsii-pacmak",
    "lint": "eslint src test",
    "test": "jest"
  },
  "jsii": {
    "outdir": "dist",
    "versionFormat": "short",
    "excludeTypescript": [
      "test"
    ],
    "tsc": {
      "outDir": "lib",
      "rootDir": "src"
    },
    "targets": {
      "python": {
        "distName": "proxylity-cdk-udp-gateway",
        "module": "proxylity_cdk_udp_gateway"
      },
      "dotnet": {
        "namespace": "Proxylity.CDK.UdpGateway",
        "packageId": "Proxylity.CDK.UdpGateway"
      }
    }
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.160.0",
    "constructs": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "aws-cdk-lib": "2.160.0",
    "constructs": "10.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jsii": "~5.9.0",
    "jsii-pacmak": "~1.140.0",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.2"
  },
  "overrides": {
    "js-yaml": "^4.0.0",
    "test-exclude": "^8.0.0"
  },
  "bundledDependencies": [],
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    ".jsii",
    "README.md"
  ]
}
